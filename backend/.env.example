# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (MongoDB URI)
MONGODB_URI=mongodb://127.0.0.1:27017/taxman_capital

# JWT Configuration
JWT_SECRET=super_secret_production_jwt_taxman_capital_2026_key_secure
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# Cloudinary File Storage Configuration
CLOUDINARY_CLOUD_NAME=taxman-capital
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service Configuration (Nodemailer SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=support@taxmancapital.com
EMAIL_PASSWORD=your_email_app_password
EMAIL_FROM="The TaxMan's Capital <noreply@taxmancapital.com>"

# AI Provider Service (Gemini API / @google/genai)
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key

# Autonomous Multi-Agent & n8n Automation Webhook
N8N_WEBHOOK_SECRET=n8n_taxman_secret_2026
